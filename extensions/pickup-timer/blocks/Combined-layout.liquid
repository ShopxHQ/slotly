{% schema %}
{
  "name": "Combined Pickup Embed",
  "target": "body",
  "settings": [
    {
      "type": "text",
      "id": "suburb_title",
      "label": "Suburb/Postcode Label",
      "default": "Enter Suburb or Postcode"
    },
    {
      "type": "text",
      "id": "suburb_placeholder",
      "label": "Suburb/Postcode Placeholder",
      "default": "e.g. 2000 or Sydney"
    },
    {
      "type": "text",
      "id": "delivery_title",
      "label": "Delivery Date Label",
      "default": "Select delivery date"
    },
    {
      "type": "checkbox",
      "id": "show_shipping",
      "label": "Show Shipping Option",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_pickup",
      "label": "Show Store Pickup Option",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_normal",
      "label": "Show Normal Shipping Option",
      "default": true
    },
    {
      "type": "text",
      "id": "shipping_label",
      "label": "Shipping Option Label",
      "default": "Shipping"
    },
    {
      "type": "text",
      "id": "pickup_label",
      "label": "Store Pickup Option Label",
      "default": "Store Pickup"
    },
    {
      "type": "text",
      "id": "normal_shipping_label",
      "label": "Normal Shipping Option Label",
      "default": "Normal Shipping"
    },
    {
      "type": "checkbox",
      "id": "show_time",
      "label": "Show time picker",
      "default": true
    },
    {
      "type": "color",
      "id": "shipping_color",
      "label": "Shipping Background Color",
      "default": "#8a9b5b"
    },
    {
      "type": "color",
      "id": "store_pickup_color",
      "label": "Store Pickup Background Color",
      "default": "#a8438c"
    },
    {
      "type": "color",
      "id": "normal_color",
      "label": "Normal Shipping Background Color",
      "default": "#5b8a9b"
    },
    {
      "type": "color",
      "id": "active_border_color",
      "label": "Active Border Color",
      "default": "#000000"
    },
    {
      "type": "html",
      "id": "custom_html",
      "label": "Custom HTML",
      "default": "<div></div>"
    },
    {
      "type": "range",
      "id": "card_border_radius",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "label": "Card Border Radius",
      "default": 10
    },
    {
      "type": "header",
      "content": "Shipping Notes"
    },
    {
      "type": "checkbox",
      "id": "show_shipping_note_1",
      "label": "Show Shipping Note 1",
      "default": false
    },
    {
      "type": "text",
      "id": "shipping_note_1_heading",
      "label": "Shipping Note 1 Heading",
      "default": "Shipping Note 1"
    },
    {
      "type": "checkbox",
      "id": "show_shipping_note_2",
      "label": "Show Shipping Note 2",
      "default": false
    },
    {
      "type": "text",
      "id": "shipping_note_2_heading",
      "label": "Shipping Note 2 Heading",
      "default": "Shipping Note 2"
    },
    {
      "type": "text",
      "id": "custom_checkout_selector",
      "label": "Custom Checkout Button Selector",
      "info": "Optional: CSS selector if the checkout button is not being blurred (e.g. .custom-checkout-btn)"
    },
    {
      "type": "select",
      "id": "options_layout",
      "label": "Options Layout",
      "options": [
        { "value": "stacked", "label": "Stacked (Vertical)" },
        { "value": "grid", "label": "Grid (Horizontal)" }
      ],
      "default": "stacked"
    },
    {
      "type": "header",
      "content": "Additional Yes/No Checkbox"
    },
    {
      "type": "checkbox",
      "id": "show_yes_no",
      "label": "Show Yes/No Checkbox",
      "default": false
    },
    {
      "type": "text",
      "id": "yes_no_label",
      "label": "Checkbox Label",
      "default": "Do you agree?"
    },
    {
      "type": "text",
      "id": "yes_text",
      "label": "Yes Text",
      "default": "Yes"
    },
    {
      "type": "text",
      "id": "no_text",
      "label": "No Text",
      "default": "No"
    }
  ]
}
{% endschema %}

{{ 'combined-pickup-style.css' | asset_url | stylesheet_tag }}

<div id="combined-wrapper-global-{{ block.id }}" class="combined-wrapper" data-combined-wrapper-initialized="false" {% if cart.item_count == 0 %}style="display: none;"{% endif %}></div>

<script src="{{ 'combined-pickup.js' | asset_url }}" defer></script>
<script>
(function () {
  let storeRules = [];
  let deliveryConfig = {};

  try {
    const metafieldValue = {{ shop.metafields.store_config.store_rules.value | default: '[]' | json }};
    if (typeof metafieldValue === 'string') {
      storeRules = JSON.parse(metafieldValue);
    } else if (Array.isArray(metafieldValue)) {
      storeRules = metafieldValue;
    }
  } catch (e) {
    console.error('[Combined Layout] Store metafield parse error:', e);
    storeRules = [];
  }

  try {
    const deliveryMeta = {{ shop.metafields.delivery_config.settings.value | json }};
    deliveryConfig = deliveryMeta && typeof deliveryMeta === 'string' ? JSON.parse(deliveryMeta) : (deliveryMeta || {});
  } catch (e) {
    console.error('[Combined Layout] Delivery metafield parse error:', e);
    deliveryConfig = {};
  }

  const CONFIG = {
    wrapperId: 'combined-wrapper-global-{{ block.id }}',
    shippingColor: '{{ block.settings.shipping_color }}',
    storePickupColor: '{{ block.settings.store_pickup_color }}',
    normalColor: '{{ block.settings.normal_color }}',
    activeBorderColor: '{{ block.settings.active_border_color }}',
    suburbTitle: {{ block.settings.suburb_title | json }},
    suburbPlaceholder: {{ block.settings.suburb_placeholder | json }},
    deliveryTitle: '{{ block.settings.delivery_title }}',
    shippingLabel: '{{ block.settings.shipping_label }}',
    pickupLabel: '{{ block.settings.pickup_label }}',
    normalShippingLabel: '{{ block.settings.normal_shipping_label }}',
    showShipping: {{ block.settings.show_shipping | json }},
    showPickup: {{ block.settings.show_pickup | json }},
    showNormal: {{ block.settings.show_normal | json }},
    showTime: {{ block.settings.show_time | json }},
    cardBorderRadius: {{ block.settings.card_border_radius | json }},
    customHtml: {{ block.settings.custom_html | json }},
    showShippingNote1: {{ block.settings.show_shipping_note_1 | json }},
    shippingNote1Heading: {{ block.settings.shipping_note_1_heading | json }},
    showShippingNote2: {{ block.settings.show_shipping_note_2 | json }},
    shippingNote2Heading: {{ block.settings.shipping_note_2_heading | json }},
    showYesNo: {{ block.settings.show_yes_no | json }},
    yesNoLabel: {{ block.settings.yes_no_label | json }},
    yesText: {{ block.settings.yes_text | json }},
    noText: {{ block.settings.no_text | json }},
    customCheckoutSelector: {{ block.settings.custom_checkout_selector | json }},
    optionsLayout: {{ block.settings.options_layout | json }},
    storeRules: storeRules,
    deliveryConfig: deliveryConfig
  };

  function waitForInit() {
    if (typeof window.initCombinedPickup === 'function') {
      window.initCombinedPickup(CONFIG);
    } else {
      setTimeout(waitForInit, 50);
    }
  }
  waitForInit();
})();
</script>
